# ──────────────────────────────────────────────────────────────────────
# EIDOLON OS — API environment configuration
# Copy to .env and edit as needed.
#
# All settings are optional. EIDOLON works with zero configuration.
# The Local Semantic Brain is always active (no API key, no network).
# ──────────────────────────────────────────────────────────────────────

# ── Ollama / Local LLM (optional upgrade) ──────────────────────────────
# Enable for more conversational, multi-turn memory answers via a local model.
# Steps:
#   1. Install Ollama: https://ollama.com/download
#   2. Start the server:  ollama serve
#   3. Pull a model:      ollama pull mistral
#   4. Set OLLAMA_ENABLED=true and restart the API.
#
# Other models: llama3.2, gemma3, phi4-mini, deepseek-r1
#
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ── Tesseract path override (optional) ─────────────────────────────────
# Only needed if Tesseract is not at the default Windows path.
# Default (auto-detected): C:\Program Files\Tesseract-OCR\tesseract.exe
#
# TESSERACT_CMD=D:\tools\Tesseract-OCR\tesseract.exe

# ── Cloud LLM (future — not yet implemented) ────────────────────────────
# Placeholder for an optional cloud upgrade path.
# No API key is required or used in the current release.
#
# CLOUD_LLM_ENABLED=false
# CLOUD_LLM_PROVIDER=openai    # openai | anthropic | groq
# CLOUD_LLM_API_KEY=sk-...
