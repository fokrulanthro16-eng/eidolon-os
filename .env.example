# ── EIDOLON OS — Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in values. Never commit .env.
# All settings have safe defaults — this file is entirely optional.
# The app runs fully without any changes to this file.

# ── Brain Provider (Phase 18 / 21) ───────────────────────────────────────────
# Which brain to use for /brain/chat and /brain/status.
# Options: local_semantic (default, no LLM), ollama, lmstudio, gemini
# Default: local_semantic — always works, no model required.
BRAIN_PROVIDER=local_semantic

# ── Gemini (optional — free Google AI Studio key) ────────────────────────────
# Set BRAIN_PROVIDER=gemini above, then fill in your free key from
# https://aistudio.google.com/app/apikey
# Falls back to local_semantic automatically if key is missing or invalid.
GEMINI_API_KEY=your_free_ai_studio_key_here
GEMINI_MODEL=gemini-2.0-flash
# Set to true to prevent the model from receiving any local memory context
# (useful for strict data-privacy deployments). Default: false.
GEMINI_ALLOW_SYSTEM_LOCKDOWN=false

# ── Ollama (optional LLM integration) ────────────────────────────────────────
# Set BRAIN_PROVIDER=ollama above to activate.
# Requires Ollama running locally: https://ollama.com/download
# Install model first: ollama pull qwen2.5:3b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── LM Studio (optional LLM integration) ─────────────────────────────────────
# Set BRAIN_PROVIDER=lmstudio above to activate.
# Requires LM Studio running locally: https://lmstudio.ai/
# Start the local server in LM Studio on port 1234 before using.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model

# ── Screen capture interval ───────────────────────────────────────────────────
# How often (seconds) the screen watcher captures a screenshot.
# Default: 30 seconds.
# CAPTURE_INTERVAL_SECONDS=30

# ── Tesseract OCR ────────────────────────────────────────────────────────────
# Path to tesseract.exe if not in PATH. Example (Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
